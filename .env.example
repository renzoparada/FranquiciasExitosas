# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-publica
# Solo servidor: invitar usuarios desde el portal. Nunca la expongas en el navegador.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
# URL pública del portal (en local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Correo (Resend) para los avisos. Sin estas variables, los avisos solo se ven en la app.
RESEND_API_KEY=
EMAIL_FROM="Franquicias Exitosas <portal@tu-dominio.com>"
# Secreto del cron diario de Vercel (cualquier texto largo aleatorio)
CRON_SECRET=
